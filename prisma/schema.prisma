// Zaki Workspace — Prisma schema (Phase 1–2: foundation + core workspace)
// Extensible: worker/AI/Telegram tables are added in later migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  // An account is created by the owner with a username + password; an e-mail address is optional
  // (moderators and warehouse staff may have none). Both are stored lower-case and are unique.
  email        String?  @unique
  username     String?  @unique
  name         String
  passwordHash String
  // Bumped to end every session of this user at once (suspend, offboard, password reset, "log out
  // everywhere"). The session token carries the value it was issued with; a mismatch is a sign-out.
  tokenVersion Int      @default(0)
  // True while the password is a temporary one chosen by the owner: the user must change it first.
  mustChangePassword Boolean @default(false)
  // The version of the "work chats are archived and visible to the owner" notice this user accepted.
  transparencyVersion    Int?
  transparencyAcceptedAt DateTime?
  lastLoginAt  DateTime?
  // Presence for the chat: written at most once a minute while the person has a live connection.
  lastSeenAt   DateTime?
  locale       String   @default("ar") // ar | fr (en reserved)
  theme        String   @default("system") // light | dark | system
  digits       String   @default("latin") // latin | arabic: how 0-9 are drawn (src/lib/digits.ts)
  avatarUrl    String?
  jobTitle     String? // وظيفي: professional title shown on profile (e.g. "Project Manager")
  bio          String?
  // «ترتيبي»: the person's own order of the menu's places and of the tabs inside each place — { places: string[], tabs: Record<placeKey, string[]> }, null = the code's order (src/lib/nav/order.ts)
  navOrder     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     OrganizationMember[] @relation("MemberUser")
  managedMembers  OrganizationMember[] @relation("MemberManager")
  workspaceLinks  WorkspaceMember[]
  teamLinks       TeamMember[]
  createdTasks    Task[]               @relation("TaskCreator")
  assignedTasks   Task[]               @relation("TaskAssignee")
  // «مهمة لأكثر من شخص»: the tasks that named this person beside their own assigneeId.
  coAssignedTasks TaskCoAssignee[]     @relation("TaskCoAssignees")
  comments        TaskComment[]
  activity        TaskActivity[]
  notifications   Notification[]
  ideas           Idea[]               @relation("IdeaCreator")
  ideaVotes       IdeaVote[]           @relation("IdeaVoter")
  cards           Card[]               @relation("CardCreator")
  cardRevisions   CardRevision[]       @relation("CardRevisionEditor")
  documents       Document[]           @relation("DocumentCreator")
  documentsEdited Document[]           @relation("DocumentLastEditor")
  documentRevisions DocumentRevision[] @relation("DocumentRevisionEditor")
  materialsMade    Material[]           @relation("MaterialCreator")
  suppliersMade    Supplier[]           @relation("SupplierCreator")
  materialLotsMade MaterialLot[]        @relation("MaterialLotCreator")
  materialMovementsMade MaterialMovement[] @relation("MaterialMovementCreator")
  materialCounts   MaterialCount[]      @relation("MaterialCounter")
  materialCountsDecided MaterialCount[] @relation("MaterialCountDecider")
  materialCostingsMade MaterialCosting[] @relation("MaterialCostingCreator")
  materialPriceCorrectionsMade MaterialPriceCorrection[] @relation("MaterialPriceCorrectionCreator")
  recipesMade      Recipe[]             @relation("RecipeCreator")
  recipeVersionsMade RecipeVersion[]    @relation("RecipeVersionCreator")
  productionOrdersMade ProductionOrder[] @relation("ProductionOrderCreator")
  cardNotes       CardNote[]           @relation("CardNoteAuthor")
  cardRatings     CardRating[]         @relation("CardRater")
  cardAttachments CardAttachment[]     @relation("CardAttachmentAdder")
  chatMemberships ConversationMember[] @relation("ChatMember")
  chatMessages    ChatMessage[]        @relation("ChatAuthor")
  chatDeletions   ChatMessage[]        @relation("ChatDeleter")
  chatReactions   ChatReaction[]
  pollVotes       PollVote[]
  chatOrders      UserChatOrder[]
  messageRevisions MessageRevision[]   @relation("RevisionEditor")
  messageNotes    MessageNote[]        @relation("NoteAuthor")
  uploadedFiles   StoredFile[]         @relation("FileUploader")
  deptMemberships DepartmentMember[]
  createdTickets  Ticket[]             @relation("TicketCreator")
  assignedTickets Ticket[]             @relation("TicketAssignee")
  ticketComments  TicketComment[]      @relation("TicketCommentAuthor")
  ticketActivity  TicketActivity[]     @relation("TicketActivityActor")
  createdCustomers Customer[]          @relation("CustomerCreator")
  ownedOpportunities Opportunity[]    @relation("OpportunityOwner")
  routines        Routine[]            @relation("RoutineAssignee")
  goals           Goal[]               @relation("GoalCreator")
  // «الأهداف والنتائج»: the objectives this person is the owner of
  ownedGoals      Goal[]               @relation("GoalOwner")
  campaigns       Campaign[]           @relation("CampaignOwner")
  startedCalls    Call[]               @relation("CallStarter")
  hostedWatches   WatchSession[]       @relation("WatchHost")
  startedWatches  WatchSession[]       @relation("WatchStarter")
  callSeats       CallPerson[]
  pushDevices     PushSubscription[]
  issuedApiTokens ApiToken[]           @relation("ApiTokenIssuer")
}

// ---------- departments (the company's pools: design / dev / IT / sales) ----------

model Department {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  emoji     String?
  color     String? // tailwind-ish token for the chip
  leadId    String? // informational lead shown on the card (must be an org member)
  createdAt DateTime  @default(now())

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships  DepartmentMember[]
  projects     Project[]
  tickets      Ticket[]
  routines     Routine[]
  goals        Goal[]
  campaigns    Campaign[]
  // The chat space of the department (Phase 3): at most one, created by the data move or on demand.
  space        Workspace?

  @@index([orgId])
}

// ---------- department products: IT tickets ----------
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id           String       @id @default(cuid())
  orgId        String
  // null: an «تذكرة فورية», handed straight to a person with no department (the owner's ask, 2026-10-27)
  departmentId String?
  number       Int // per-org sequential → key `${prefix}-T${number}`
  title        String
  description  String?
  status       TicketStatus @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  creatorId    String
  assigneeId   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creator      User         @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments     TicketComment[]
  activities   TicketActivity[]
  // Made from a chat message («اعمل منها تذكرة»): the message it came from.
  sourceMessageId String?
  sourceMessage   ChatMessage? @relation("MessageTickets", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([departmentId, status])
  @@index([sourceMessageId])
  @@index([orgId])
  @@index([assigneeId])
}

model TicketComment {
  id       String    @id @default(cuid())
  ticketId String
  authorId String
  body     String
  editedAt DateTime?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketCommentAuthor", fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String
  event     String // created | status_changed | assigned | commented | edited
  meta      Json?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation("TicketActivityActor", fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

// ---------- department products: campaign calendar ----------
enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  DONE
  CANCELLED
}

model Campaign {
  id           String         @id @default(cuid())
  orgId        String
  departmentId String
  number       Int // per-org sequential → key `${prefix}-C${number}`
  title        String
  description  String?
  status       CampaignStatus @default(DRAFT)
  priority     TaskPriority   @default(NORMAL)
  startDate    DateTime
  endDate      DateTime
  ownerId      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  owner        User         @relation("CampaignOwner", fields: [ownerId], references: [id])
  items        CampaignItem[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([departmentId, startDate])
}

// A dated item on the campaign calendar (post / event / task-link).
model CampaignItem {
  id         String    @id @default(cuid())
  campaignId String
  title      String
  kind       String    @default("post") // post | event | task
  dueDate    DateTime
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, dueDate])
}

// ---------- daily production & goals ----------
model Routine {
  id           String   @id @default(cuid())
  orgId        String
  departmentId String?
  title        String
  description  String?
  assigneeId   String? // who performs it today ("توزيع المهام")
  weekdays     String   @default("") // csv weekday numbers 0-6 (0=Sunday); "" = every day
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // The space it belongs to (the owner's decision, 2026-10-25: each space is like a separate site). None: from
  // before spaces had their own, read in «الشركة».
  workspaceId String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("RoutineAssignee", fields: [assigneeId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  logs         RoutineLog[]

  @@index([orgId])

  @@index([orgId, workspaceId])
}

model RoutineLog {
  id            String   @id @default(cuid())
  routineId     String
  day           String // local date "YYYY-MM-DD"
  completedById String
  completedAt   DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, day])
  @@index([day])
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  // «الأهداف والنتائج»: a calendar quarter (added by its own migration, 20261103170000)
  QUARTERLY
}

/// «الأهداف والنتائج»: the status light a PERSON sets on an objective. The system only suggests one (src/lib/okr.ts).
enum GoalLight {
  ON_TRACK
  BEHIND
  AT_RISK
}

model Goal {
  id           String     @id @default(cuid())
  orgId        String
  title        String
  description  String?
  period       GoalPeriod
  periodStart  DateTime
  periodEnd    DateTime
  progress     Int        @default(0) // 0..100
  departmentId String?
  creatorId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // The space it belongs to (the owner's decision, 2026-10-25: each space is like a separate site). None: from
  // before spaces had their own, read in «الشركة».
  workspaceId String?
  // «الأهداف والنتائج»: the person who answers for the objective (none: its creator), and the light that person set
  // (none: nobody set one yet). `light` is never computed here: the screen only suggests one.
  ownerId     String?
  light       GoalLight?
  lightSetAt  DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator      User         @relation("GoalCreator", fields: [creatorId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner       User?        @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  keyResults  KeyResult[]

  @@index([orgId, period])
  @@index([departmentId])

  @@index([orgId, workspaceId])
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  role         String   @default("member") // lead | member
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

// ---------- file library (versioned org files; strict sniffed types) ----------

model StoredFile {
  id         String    @id @default(cuid())
  orgId      String
  uploaderId String
  familyId   String // versions share one family; equals own id for v1
  name       String // display name (original filename)
  path       String // server-relative storage path (never exposed raw)
  mimeType   String // sniffed from bytes, never trusted from client
  size       Int
  version    Int       @default(1)
  isLatest   Boolean   @default(true)
  deletedAt  DateTime?
  // Where the file belongs: LIBRARY (the file library lists only these) | CHAT (an attachment) | VOICE (a voice message).
  purpose    String    @default("LIBRARY")
  // Chat uploads carry their attachment facts here until the message claims them
  // (image width/height; voice durationMs and peaks). Null for every library file.
  meta       Json?
  // A library file's space (the owner's decision, 2026-10-25: each space has its own library). None: a file from
  // before spaces had libraries, read in «الشركة»; and every chat file (it goes with its conversation).
  workspaceId String?
  createdAt  DateTime  @default(now())

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader     User                @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  chatLinks    MessageAttachment[]
  cards        Card[]              @relation("CardFile")
  coverOf      Card[]              @relation("CardCover")
  cardLinks    CardAttachment[]    @relation("CardAttachmentFile")

  @@index([orgId, familyId, isLatest])
  @@index([familyId])
  @@index([orgId, purpose])
  @@index([orgId, workspaceId])
}

// ---------- internal chat (Phase: real-time rooms over the org boundary) ----------

// A conversation is one of three things (`kind`):
//   DM     two people of one company; at most one per pair (`dmKey`)
//   TOPIC  a topic inside a space (`spaceId`): its audience is the space's people unless `restricted`
//   GROUP  legacy: a group of the previous release. The Phase 3 data move turns every one into a
//          space with a general TOPIC; the value stays valid for rows written by a release still running.
model Conversation {
  id            String    @id @default(cuid())
  orgId         String
  kind          String // DM | GROUP (legacy) | TOPIC
  title         String? // TOPIC / GROUP
  emoji         String? // identity marker (🎨 💻 …)
  // ---- topics (Phase 3) ----
  // The space the topic lives in. A space that has topics (chat history) can never be deleted: RESTRICT.
  spaceId       String?
  topicType     String    @default("DISCUSSION") // DISCUSSION | ANNOUNCEMENTS | TASKS | IDEAS | FOLLOWUP
  postingPolicy String    @default("ALL") // ALL | ADMINS
  // restricted: only the people with a ConversationMember row are its audience, not the whole space.
  restricted    Boolean   @default(false)
  closedAt      DateTime? // closed topics take no new messages; admins reopen
  // Archived: out of the space's list (its managers find it under «المؤرشفة»), read-only, nothing deleted.
  archivedAt    DateTime?
  // Pinned on top of its space's list.
  pinnedAt      DateTime?
  position      Int       @default(0) // order of the topics inside the space
  // The role of a system topic: announcements | followup | general | ideas | archive (one per space).
  systemKey     String?
  // DM only: the two user ids, smaller first, joined with "|". Unique per company (a person can work in
  // two companies and has a DM with the same colleague in each). Born NULL; the data move fills it for
  // the OLDEST DM of each pair.
  dmKey         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space        Workspace?           @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  // A topic that belongs to a team of its space: its audience is that team and the space's managers.
  teamId       String?
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  members      ConversationMember[]
  messages     ChatMessage[]
  whiteboard   Whiteboard?
  calls        Call[]
  watch        WatchSession?

  @@unique([orgId, dmKey])
  @@unique([spaceId, systemKey])
  @@index([orgId, updatedAt])
  @@index([spaceId, position])
  @@index([teamId])
}

model ConversationMember {
  id              String    @id @default(cuid())
  conversationId  String
  userId          String
  role            String    @default("member") // member | admin (GROUP)
  lastReadAt      DateTime  @default(now())
  // Newest moment a device of this person received the conversation (DM ticks: sent / delivered / read).
  lastDeliveredAt DateTime?
  // The person's own notification mute (Phase 5). It does NOT stop them posting: the moderators' mute is
  // WorkspaceMember.mutedUntil.
  mutedUntil      DateTime?
  joinedAt        DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ChatMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id              String    @id @default(cuid())
  orgId           String
  conversationId  String
  authorId        String
  // Deleting a message KEEPS its text from Phase 3 on (the owner reads the original in the archive);
  // what people see is decided in one place: src/server/chat/redact.ts.
  body            String
  kind            String    @default("TEXT") // TEXT | VOICE | SYSTEM | POLL
  replyToId       String?
  pinned          Boolean   @default(false)
  editedAt        DateTime?
  deletedAt       DateTime? // tombstone: the row is kept for threads and the archive
  deletedById     String? // who deleted it (the author, a space admin or the owner)
  forwardedFromId String? // the ORIGINAL message of a forward
  mentions        String[]  @default([]) // user ids
  // Sending is idempotent: a client retry with the same clientId never creates a second message.
  clientId        String?
  // «نتفرّج سوا»: the second of the video the comment was written at (only in a watching session's topic)
  videoAtSec      Float?
  createdAt       DateTime  @default(now())

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author        User                @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy     User?               @relation("ChatDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo       ChatMessage?        @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       ChatMessage[]       @relation("ChatReplies")
  forwardedFrom ChatMessage?        @relation("ChatForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards      ChatMessage[]       @relation("ChatForwards")
  reactions     ChatReaction[]
  // «استطلاع»: the poll a POLL message carries (its question is the message body)
  poll          Poll?
  revisions     MessageRevision[]
  notes         MessageNote[]
  attachments   MessageAttachment[]
  // the tasks and tickets made from this message
  tasks         Task[]              @relation("MessageTasks")
  // «ذكّرني» on this message (src/server/services/reminders.ts)
  reminders     Reminder[]
  tickets       Ticket[]            @relation("MessageTickets")

  @@unique([authorId, clientId])
  @@index([conversationId, createdAt])
  @@index([orgId, createdAt])
}

model ChatReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// «استطلاع»: a poll inside a topic. The message (kind POLL) carries the question in its body; the poll,
// its options and the votes hang off it, so deleting the message hides the poll like any message.
model Poll {
  id         String    @id @default(cuid())
  messageId  String    @unique
  multiple   Boolean   @default(false)
  anonymous  Boolean   @default(false)
  closesAt   DateTime? // the deadline («يُغلق بعد»), at most 7 days from the creation
  closedAt   DateTime? // closed early by hand
  closedById String?
  createdAt  DateTime  @default(now())

  message ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, position])
}

// One row per person per chosen option. A single-choice poll keeps at most one row per person (the service
// replaces it); the owner in silent oversight never has a row (voting makes him join first).
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId, userId])
  @@index([optionId])
}

// A person's OWN order of the chat list (drag and drop, «ترتيب»). One row per person per list: `scope` is
// `space:<spaceId>` (the topics of that space) or `dm` / `dm:<spaceId>` (their private chats). `order` is an
// array of conversation ids (at most 500). Nobody else ever reads it: the moderator's pin and the space's own
// order are untouched, and an id the person may no longer read is simply ignored when the list is built.
model UserChatOrder {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  scope     String
  order     Json
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, scope])
}

// The text a message had BEFORE an edit. One row per edit; only the owner reads them.
model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  body      String
  editorId  String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editor  User        @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

// An internal note on a message: seen only by the admins of its space and by the owner.
model MessageNote {
  id        String   @id @default(cuid())
  messageId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User        @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

// A file attached to a message. The bytes are a StoredFile (purpose CHAT / VOICE), never listed in the library.
// An upload exists first and is claimed by a message afterwards: until then `messageId` is NULL (only its
// uploader can open it, and an unclaimed row older than a day is cleaned up). A forward links the same file
// again from a new message.
model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String?
  fileId     String
  kind       String // IMAGE | VIDEO | AUDIO | FILE
  name       String?
  width      Int?
  height     Int?
  durationMs Int?
  peaks      Json? // voice waveform: up to 100 integers 0..100
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([messageId, position])
  @@index([fileId])
}

// The bus of the chat: every change writes one row (ids only, never content) inside the same transaction;
// a trigger notifies the listener (channel zaki_rt, payload = the row id). Rows older than two days are purged.
// ⚠️ `id` is a BigInt: convert it (String(id)) before JSON.stringify, which throws on a bigint.
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  orgId     String
  kind      String // message.created | message.edited | ... (src/server/realtime/emit.ts)
  ids       Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orgId, id])
}

// The shared whiteboard of a conversation («الصبورة», the owner's ask of 2026-10-25): Excalidraw (MIT) draws in the
// browser, and its drawing is kept here as the list of its elements. One per conversation, born the first time somebody
// draws. Whoever reads the conversation sees it; whoever may write there draws (src/server/chat/whiteboard.ts).
model Whiteboard {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String   @unique
  // the Excalidraw elements (shapes, arrows, text, freehand); a deleted one stays with `isDeleted` so every screen drops it
  elements       Json     @default("[]")
  // goes up by one on every save: a screen that is behind asks again
  version        Int      @default(0)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// A voice / video call on the company's own calls server (LiveKit, self-hosted on Coolify: calls.workspace.zakiai.io). The
// sound and the picture never touch this database: these rows say WHO may be in a call. A call belongs to a
// conversation (a topic, a DM: its readers are its people) or, with no conversation, it is a meeting of a space
// opened by its link (the space's people). src/server/policy/call.ts decides; src/server/calls/ acts.
model Call {
  id             String    @id @default(cuid())
  orgId          String
  // the space it lives in (a meeting's, or its conversation's); null only for a DM from before spaces had DMs
  spaceId        String?
  conversationId String?
  title          String? // a meeting's name
  video          Boolean   @default(false) // started with the camera on
  startedById    String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space        Workspace?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedBy    User          @relation("CallStarter", fields: [startedById], references: [id], onDelete: Cascade)
  people       CallPerson[]

  @@index([conversationId, endedAt])
  @@index([spaceId, startedAt])
  @@index([orgId, startedAt])
}

// One person's seat in a call: brought in by «ضيف حدا» (`invitedById`: they may join without reading the
// conversation, the call only), or taken out (`removedAt`: no new pass for this call).
model CallPerson {
  id          String    @id @default(cuid())
  callId      String
  userId      String
  invitedById String?
  removedAt   DateTime?
  removedById String?
  // the first time this person got a pass into the call (they answered / joined): a DM call nobody answered is missed
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId])
}

// One browser of one person that agreed to be rung when the site is closed (Web Push; the browser's own push
// service carries «فلان عم يرنّ» and nothing else). Removed when the push service says the browser is gone.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  // the push service's address for this browser: unique, a browser subscribes once
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// «نتفرّج سوا» (the owner's ask, 2026-10-26): people of a space watch ONE link together. Its talk is a restricted
// topic (🎬) of that space, so who may see it, the chat, the call and the whiteboard are the topic's own rules.
// Links only: nothing is uploaded or stored but the link. The playback fields are the host's remote: what plays,
// from where, as of when (a late joiner computes where the others are from them).
model WatchSession {
  id             String    @id @default(cuid())
  orgId          String
  spaceId        String
  conversationId String    @unique
  hostId         String
  // who started it (the host may hand the remote to somebody else; null: from before the remote could move)
  startedById    String?
  title          String
  sourceKind     String // YOUTUBE
  sourceRef      String // the video's own id at its site
  sourceUrl      String // the link as it was pasted
  playing        Boolean   @default(false)
  positionSec    Float     @default(0)
  stateAt        DateTime  @default(now())
  // goes up by one on every change of the remote: a screen drops an answer older than the one it has
  version        Int       @default(0)
  // «الكل بيتحكّم»: everybody of the session holds the remote, not only the host
  everyoneControls Boolean @default(false)
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space        Workspace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  host         User         @relation("WatchHost", fields: [hostId], references: [id], onDelete: Cascade)
  startedBy    User?        @relation("WatchStarter", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
  @@index([orgId])
  @@index([hostId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  keyPrefix String   @unique // used for task keys, e.g. ZW -> ZW-42
  joinCode  String   @unique // legacy self-serve join code: no longer honoured (accounts are created by the owner)
  // The company's clock: "today", overdue and quiet hours are computed in this zone, not the server's.
  timezone  String   @default("Asia/Damascus")
  // Validated per key in code (src/server/policy/org-settings.ts): transparency notice version, etc.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  workspaces       Workspace[]
  taskCounter      TaskCounter?
  tasks            Task[]
  ideas            Idea[]
  ideaVotes        IdeaVote[]
  cards            Card[]
  documents        Document[]
  materials        Material[]
  suppliers        Supplier[]
  materialCostings MaterialCosting[]
  materialPriceCorrections MaterialPriceCorrection[]
  recipes          Recipe[]
  productionOrders ProductionOrder[]
  integrations     Integration[]
  conversations    Conversation[]
  IntegrationEvent IntegrationEvent[]
  ChatMessage      ChatMessage[]
  chatOrders       UserChatOrder[]
  files            StoredFile[]
  departments      Department[]
  tickets          Ticket[]
  customers        Customer[]
  opportunities    Opportunity[]
  routines         Routine[]
  goals            Goal[]
  campaigns        Campaign[]
  whiteboards      Whiteboard[]
  calls            Call[]
  watchSessions    WatchSession[]
  skills           Skill[]
  personSkills     PersonSkill[]
  skillHistory     PersonSkillHistory[]
  reviewCriteria   ReviewCriterion[]
  reviews          Review[]
  devGoals         DevGoal[]
  reviewNotes      ReviewNote[]
  apiTokens        ApiToken[]
  idempotencyRecords IdempotencyRecord[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  // Only ACTIVE members can use the app. A suspended or offboarded member keeps the row (history,
  // authorship) but every guard treats them as absent.
  status         MemberStatus @default(ACTIVE)
  // Capabilities on top of / taken away from what the rank grants (src/server/policy/capabilities.ts).
  capabilities        String[] @default([])
  revokedCapabilities String[] @default([])
  // The company's first OWNER: the only one who makes or unmakes another OWNER (a partner, «شريك») and takes a
  // permission away from one. Nobody administers him. Other OWNERs are partners with everything he leaves them.
  primaryOwner        Boolean  @default(false)
  // Who escalations go to (the person's manager); null = the owner.
  managerId      String?
  // The same person's reference in the OMS (staff, penalties, cash custody), for later integration.
  omsStaffRef    String?
  statusChangedAt   DateTime?
  statusChangedById String?
  // «آخر ظهور»: the last moment this person was at their screen in THIS company (written by the real-time presence, at
  // most once a minute: src/server/realtime/presence.ts), and their own «إخفاء آخر ظهوري» choice (null counts as false).
  lastSeenAt        DateTime?
  hideLastSeen      Boolean? @default(false)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  manager      User?        @relation("MemberManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@unique([organizationId, omsStaffRef])
  @@index([userId])
  @@index([organizationId, status])
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum OrgRole {
  OWNER
  ADMIN
  // Team lead (manager-lite): hands out work to the people under them and receives escalations.
  LEAD
  MEMBER
  GUEST
}

// ---------- Workspaces / teams ----------

// A space: the place where a team works AND talks. Its topics are the conversations that point at it.
model Workspace {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  // STANDARD: made by people | DEPARTMENT: the chat of a department | HQ: the company-wide space (one per company)
  kind           WorkspaceKind @default(STANDARD)
  // What the space is made of: STANDARD (work, chat, files ...) | CARDS (only «لوحات»: notes, prompts, lists, links, files, tables)
  // | MANUFACTURING («تصنيع»: the same cards for now, plus the note that stock and cost numbers come from the official ledger).
  // A plain string, not an enum: `kind` keeps its own meaning (who the space is for).
  layout         String        @default("STANDARD")
  emoji          String?
  // The role of a system space: "hq". Unique per company, so there is exactly one HQ.
  systemKey      String?
  // DEPARTMENT spaces: the department they belong to (at most one space per department).
  departmentId   String?       @unique
  // The order on the space lists (the switcher, «كل المساحات»), set by dragging; «الشركة» is always first.
  position       Int           @default(0)
  // Archived: off every list, its things kept as they are; the owner and the admins bring it back from «كل المساحات».
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  notifications Notification[]
  members       WorkspaceMember[]
  ideas         Idea[]
  teams         Team[]
  files         StoredFile[]
  projects      Project[]
  taskRecurrences TaskRecurrence[]
  conversations Conversation[]
  goals         Goal[]
  routines      Routine[]
  customers     Customer[]
  opportunities Opportunity[]
  calls         Call[]
  watchSessions WatchSession[]
  cards         Card[]
  documents     Document[]
  materials     Material[]
  suppliers     Supplier[]
  materialCostings MaterialCosting[]
  materialPriceCorrections MaterialPriceCorrection[]
  recipes       Recipe[]
  productionOrders ProductionOrder[]
  checkinConfig CheckinConfig?
  checkinRounds CheckinRound[]
  apiTokens     ApiToken[]

  @@unique([organizationId, slug])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
}

enum WorkspaceKind {
  STANDARD
  DEPARTMENT
  HQ
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  // The moderators' mute: until this moment the person cannot post in ANY topic of the space.
  // NULL = not muted; "forever" is stored as 9999-12-31.
  mutedUntil  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  GUEST
}

// A team INSIDE a space (the owner's decision, 2026-10-25: «جوّا المساحة فرق، كل فريق إله مشاريعه ومواضيعه»).
// A space with no team works exactly as before; once it has teams, a member sees the space's own work (no
// team) and the work of their teams, and the space's managers see all of it (src/server/services/team-scope.ts).
model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  leadId      String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects      Project[]
  members       TeamMember[]
  conversations Conversation[]

  @@index([workspaceId])
}

// Who is in a team. Only people with a row in the team's space may be added (the service checks).
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  ARCHIVED
}

model Project {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  status       ProjectStatus @default(PLANNING)
  priority     TaskPriority  @default(NORMAL)
  ownerId      String?
  departmentId String?
  startDate    DateTime?
  targetDate   DateTime?
  // The role of a project the app keeps for itself: "instant" holds the space's «مهام فورية» (one per space).
  systemKey    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team?           @relation(fields: [teamId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId     String?
  boards     Board[]
  tasks      Task[]
  milestones Milestone[]
  // «الأهداف والنتائج»: the key results whose value follows this project's finished tasks
  keyResults KeyResult[]
  taskRecurrences TaskRecurrence[]
  // «حقول مخصصة»: the project's own schema of task fields (they die with the project)
  customFields ProjectField[]
  // «القواعد التلقائية»: the if-then rules of the project and (through them) their log (both die with the project)
  taskRules TaskRule[]

  @@unique([workspaceId, systemKey])
  @@index([workspaceId])
  @@index([status])
  @@index([departmentId])
  @@index([teamId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(OPEN)
  ownerId     String?
  targetDate  DateTime?
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

enum MilestoneStatus {
  OPEN
  COMPLETED
  OVERDUE
}

// ---------- Boards / workflow ----------

model Board {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]
  tasks   Task[]
  taskRecurrences TaskRecurrence[]

  @@index([projectId])
}

model BoardColumn {
  id       String  @id @default(cuid())
  boardId  String
  name     String
  color    String  @default("#6b7280")
  position Int // 0..n display order
  done     Boolean @default(false) // marks terminal columns; drives "completed" semantics

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([boardId, name])
  @@index([boardId, position])
}

// ---------- Tasks ----------

enum TaskPriority {
  URGENT
  HIGH
  NORMAL
  LOW
  NONE
}

enum TaskType {
  TASK
  BUG
  FEATURE
  IMPROVEMENT
  RESEARCH
  MEETING
  CONTENT
  MARKETING
  OPERATIONS
  AUTOMATION
  AI_AGENT
}

model TaskCounter {
  organizationId String @id
  lastNumber     Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  number      Int // per-organization sequential number -> key is `${prefix}-${number}`
  orgId       String
  workspaceId String
  projectId   String
  boardId     String
  columnId    String
  title       String
  description String?
  priority    TaskPriority @default(NORMAL)
  type        TaskType     @default(TASK)
  creatorId   String
  assigneeId  String?
  teamId      String?
  milestoneId String?
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  archived    Boolean      @default(false)
  position    Decimal      @db.Decimal(22, 10)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board        Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column       BoardColumn      @relation(fields: [columnId], references: [id])
  creator      User             @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // «لمين» with more than one person: the people beside assigneeId (who stays the first of them).
  coAssignees  TaskCoAssignee[]
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id])
  labels       TaskLabel[]
  comments     TaskComment[]
  activities   TaskActivity[]
  dependencies TaskDependency[] @relation("Task")
  blocksTask   TaskDependency[] @relation("BlockedTask")
  assignRequests TaskAssignRequest[]
  // «خطوات»: the short checklist of the task; «ذكّرني»: the reminders people set on it (both die with the task)
  steps          TaskStep[]
  reminders      Reminder[]
  // «حقول مخصصة»: the values of the project's custom fields on this task (they die with the task)
  fieldValues    TaskFieldValue[]
  // «الأهداف والنتائج»: the key results this task is linked to (the link dies with the task)
  keyResultLinks KeyResultTask[]
  // «حساب وقت الشغل»: the time people logged on it. An entry OUTLIVES the task (the foreign key sets taskId to null).
  timeEntries    TimeEntry[]
  // «مهمة متكررة»: the series this task belongs to (every occurrence points at it), and the series it is the template of
  recurrenceId   String?
  recurrence     TaskRecurrence? @relation("RecurrenceTasks", fields: [recurrenceId], references: [id], onDelete: SetNull)
  templateOf     TaskRecurrence? @relation("RecurrenceTemplate")
  // Made from a chat message («اعمل منها مهمة»): the message it came from.
  sourceMessageId String?
  sourceMessage   ChatMessage? @relation("MessageTasks", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  // «مهمة بمكافأة» (the owner, 2026-10-30): only the OWNER rank sets, edits, cancels or deletes. The amount is an integer in
  // MINOR units (cents, never a float); `rewardStatus` is NONE | OPEN | AWARDED | CANCELLED (null = no reward). No foreign keys on
  // purpose: the award is history. The app records and approves; it never moves money. A partner (GUEST) never receives these.
  rewardAmountMinor  Int?
  rewardCurrency     String?
  rewardNote         String?
  rewardStatus       String?
  rewardAwardedToId  String?
  rewardAwardedAt    DateTime?
  rewardApprovedById String?
  rewardCancelReason String?
  rewardCancelledAt  DateTime?
  // «تثبيت»: a pinned task sorts first and shows in the strip at the top of its project; the owner and the space's ADMIN pin.
  pinnedAt           DateTime?
  pinnedById         String?

  // «الباب»: a task sent in through /api/v1: the token that made it and the sender's own opaque reference.
  apiTokenId         String?
  apiToken           ApiToken? @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  externalRef        String?

  @@unique([orgId, number])
  @@index([orgId, rewardStatus])
  @@index([workspaceId, pinnedAt])
  @@index([apiTokenId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([projectId, archived])
  @@index([sourceMessageId])
  @@index([boardId, columnId, position])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([dueDate])
  @@index([recurrenceId])
}

enum RecurrenceMode {
  ON_COMPLETE
  SCHEDULE
}

/// «مهمة متكررة»: one repeating series. The template task is the one the person marked repeating; every occurrence is a
/// REAL task made by `createTask` on behalf of `createdById` and points back here (`Task.recurrenceId`). `rule` is the
/// zod-validated shape of src/lib/task-recurrence.ts; `mode`: ON_COMPLETE (the next one is made when the current one is
/// finished) or SCHEDULE (the job runner makes it at `nextDueAt`, claimed with an UPDATE so it happens once). `endsAt` is
/// the last instant of the day the series ends; `stoppedReason` says why an automatic stop happened (null: a person stopped it).
model TaskRecurrence {
  id             String         @id @default(cuid())
  orgId          String
  workspaceId    String
  projectId      String
  boardId        String
  templateTaskId String         @unique
  createdById    String
  rule           Json
  mode           RecurrenceMode
  nextDueAt      DateTime?
  endsAt         DateTime?
  active         Boolean        @default(true)
  stoppedReason  String?
  lastCreatedAt  DateTime?
  createdAt      DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  template  Task      @relation("RecurrenceTemplate", fields: [templateTaskId], references: [id], onDelete: Cascade)
  tasks     Task[]    @relation("RecurrenceTasks")

  @@index([active, mode, nextDueAt])
  @@index([orgId])
}

/// «خطوات»: the short checklist inside a task (the owner, 2026-10-30). One row per step; `position` is fractional like the
/// rest of the code (a move writes ONE row). Whoever may edit the task may edit its steps; `doneById` is who ticked it.
/// No foreign key to the people on purpose (the same as `Notification`): the step is history and outlives a person's row;
/// it dies with its task.
model TaskStep {
  id        String    @id @default(cuid())
  orgId     String
  taskId    String
  title     String
  done      Boolean   @default(false)
  doneById  String?
  doneAt    DateTime?
  position  Decimal   @db.Decimal(22, 10)
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  PENDING
  FIRED
  DISMISSED
}

/// «ذكّرني»: a person's reminder for THEMSELVES (never for somebody else), on a task, on a chat message, or on its own.
/// The in-app job runner (src/server/jobs/) claims a due PENDING row once (`UPDATE ... WHERE status = 'PENDING'`),
/// writes the bell notification, and a repeating one is re-armed in the same transaction (`dueAt` moves to the next
/// occurrence in the company's zone, `status` goes back to PENDING). `snoozedUntil` is the next due time while snoozed
/// (`dueAt` is moved too: the runner only reads `dueAt`). No foreign key to the person (history, like `Notification`).
model Reminder {
  id           String         @id @default(cuid())
  orgId        String
  userId       String
  title        String
  dueAt        DateTime
  repeat       ReminderRepeat @default(NONE)
  taskId       String?
  messageId    String?
  status       ReminderStatus @default(PENDING)
  firedAt      DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime       @default(now())

  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([userId, status])
  @@index([taskId])
  @@index([messageId])
}

/// «حساب وقت الشغل» (the owner, 2026-10-30): one row per stretch of work a person logged on a task. A TIMER row is opened
/// by «ابدأ» (`stoppedAt` null = running) and closed by «وقّف» from the SERVER's clock: `seconds` is whole seconds and never
/// a float. A MANUAL row is typed in (date, hours, minutes); its `startedAt` is noon of that day in the company's zone and
/// `stoppedAt = startedAt + seconds`. At most ONE running row per person: the partial unique index
/// "TimeEntry_one_running_per_user" (hand-written in the migration: Prisma cannot express a WHERE on an index) is the
/// backstop of the service's per-person lock. The row keeps `taskTitle` (a snapshot) and survives its task: the foreign key
/// sets `taskId` to null when the task row is hard-deleted; an archived task keeps its rows untouched. No foreign key to
/// the person, the space or the company on purpose (history, like `Notification`). Every change is kept in `AuditLog`.
/// A timer left running more than 12 hours is closed at `startedAt + 12h` by the job runner and marked `autoStopped`.
enum TimeEntrySource {
  TIMER
  MANUAL
}

model TimeEntry {
  id          String          @id @default(cuid())
  orgId       String
  workspaceId String
  userId      String
  taskId      String?
  taskTitle   String
  startedAt   DateTime
  stoppedAt   DateTime?
  seconds     Int             @default(0)
  note        String          @default("")
  source      TimeEntrySource
  autoStopped Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([taskId])
  @@index([workspaceId, startedAt])
}

/// «اشتراك التقويم»: the private link a person adds ONCE to Google / Apple / Outlook calendar. The link carries a random
/// token that IS the credential; only its SHA-256 is stored here, the token itself is shown once, on creation. No foreign
/// keys on purpose (the same as `Reminder`): nothing is ever deleted, and the feed re-checks the person on every request.
/// `sessionVersion` is the person's `User.tokenVersion` at creation: a suspend, reset or "log out everywhere" bumps it and
/// the link stops working at once.
model CalendarFeedToken {
  id             String    @id @default(cuid())
  orgId          String
  userId         String
  tokenHash      String    @unique
  label          String
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([userId, revokedAt])
}

/// Giving a task to somebody of a HIGHER rank is a request, not an assignment (the owner's rule, 2026-10-30): the task
/// stays as it was, this row waits for the addressed person, who accepts (the task is then theirs) or returns it with
/// a written reason. No foreign key to the people on purpose (the same as `Notification`): the row is history and
/// outlives a person's row; it dies with its task.
enum TaskAssignRequestStatus {
  PENDING
  ACCEPTED
  RETURNED
}

model TaskAssignRequest {
  id         String                  @id @default(cuid())
  orgId      String
  taskId     String
  fromUserId String
  toUserId   String
  status     TaskAssignRequestStatus @default(PENDING)
  reason     String?
  /// «لمين» with more than one person: the request was for somebody BESIDE the task's first person. Accepting it adds
  /// them to the people of the task (`TaskCoAssignee`) instead of handing them the main assignee column. A task may hold
  /// one pending request of the main kind and one pending request per higher person of the co kind.
  asCo       Boolean                 @default(false)
  createdAt  DateTime                @default(now())
  answeredAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([toUserId, status])
}

// «المهمة لأكثر من شخص» — the extra people a task is for, beside the one in Task.assigneeId
// (that column stays the first person named, so every old read keeps working). A row is a pairing,
// like TaskLabel: no state of its own.
model TaskCoAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskCoAssignees", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Label {
  id    String @id @default(cuid())
  orgId String
  name  String
  color String @default("#6b7280")

  tasks TaskLabel[]

  @@unique([orgId, name])
  @@index([orgId])
}

// relationships: blocks / blockedBy / duplicates
enum TaskDependencyKind {
  BLOCKS
  BLOCKED_BY
  DUPLICATES
}

model TaskDependency {
  id          String             @id @default(cuid())
  taskId      String
  dependsOnId String
  kind        TaskDependencyKind @default(BLOCKS)

  task      Task @relation("Task", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockedTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId, kind])
  @@index([dependsOnId])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

// structured events; no free-form parsing
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  event     String // created | moved | assigned | commented | due_changed | ...
  meta      Json?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // task_assigned | mentioned | due_soon | comment ...
  title     String
  body      String?
  linkUrl   String?
  taskId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  // The space the notification belongs to (a task's, a topic's or a DM's, a space one was added to): the bell shows
  // the space the person is in. None: personal (a welcome, a changed rank), shown in every space — and the
  // notifications from before spaces had them.
  workspaceId String?
  // The company the notification belongs to. A person may be in two companies: their personal notices (a welcome,
  // a changed rank, a ticket with no space) must not appear in the other company's bell (review B7). No foreign
  // key on purpose: a notice outlives the company row it mentions.
  organizationId String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, workspaceId, readAt])
  @@index([userId, organizationId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  orgId     String?
  action    String // auth.login | org.created | task.deleted | chat.oversight_read ...
  target    String?
  meta      Json?
  // Moderation and oversight trails (Phase 3): which space / conversation the entry is about.
  // No foreign keys on purpose: an audit row outlives what it describes.
  workspaceId    String?
  conversationId String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([action, createdAt])
  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

enum IdeaStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  PLANNING
  LAUNCHED
}

model Idea {
  id          String     @id @default(cuid())
  orgId       String
  creatorId   String
  title       String
  description String?
  status      IdeaStatus @default(NEW) // NEW -> UNDER_REVIEW -> PLANNING -> LAUNCHED, or REJECTED (ACCEPTED: before PLANNING existed)
  taskId      String? // set when converted into a real task
  // The space the idea was born in (the owner's decision, 2026-10-25: each space has its own ideas). None: an idea
  // from before spaces had them, read in «الشركة».
  workspaceId String?
  // Shared with the company («شارك مع الشركة»): read in «الشركة» too.
  sharedAt    DateTime?
  // «الباب» (an idea sent in by another Zaki system through /api/v1): where it came from (the sending token's name at that
  // moment), the sender's own opaque reference, free tags, and the token (the foreign key keeps the idea when a token goes).
  source      String?
  externalRef String?
  tags        String[]   @default([])
  apiTokenId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("IdeaCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  apiToken     ApiToken?    @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  votes        IdeaVote[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([orgId, workspaceId])
  @@index([apiTokenId, createdAt])
}

model IdeaVote {
  id        String   @id @default(cuid())
  orgId     String
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  idea         Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user         User         @relation("IdeaVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([orgId])
}

// ---------- integrations (per org, secrets stored AES-256-GCM-encrypted) ----------

enum IntegrationType {
  TELEGRAM
  N8N
  GOOGLE_DRIVE
}

model Integration {
  id         String          @id @default(cuid())
  orgId      String
  type       IntegrationType
  connected  Boolean         @default(false)
  config     Json? // non-secret metadata: botUsername, webhookUrl, events[], email
  secretEnc  String? // AES-256-GCM JSON blob; never logged, never returned raw
  lastSyncAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chats        TelegramChat[]
  messages     TelegramMessage[]
  events       IntegrationEvent[]

  @@unique([orgId, type])
}

model TelegramChat {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  chatId        String // platform chat id as string
  title         String
  type          String // private | group | supergroup | channel
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId])
  @@index([orgId])
}

model TelegramMessage {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  chatId        String // platform chat id
  messageId     Int // platform message id
  fromName      String
  fromId        String?
  text          String?
  isCommand     Boolean  @default(false)
  sentAt        DateTime
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId, messageId])
  @@index([orgId, sentAt])
}

model IntegrationEvent {
  id        String   @id @default(cuid())
  orgId     String
  direction String // OUT | IN
  type      String // task.created | n8n.test | google.sync ...
  payload   Json?
  status    String   @default("OK") // OK | FAILED
  detail    String?
  createdAt DateTime @default(now())

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String?

  @@index([orgId, createdAt])
  @@index([orgId, direction])
}

// ---------- CRM (Sales) ----------

model Customer {
  id             String       @id @default(cuid())
  orgId          String
  name           String
  company        String?
  email          String?
  phone          String?
  notes          String?
  creatorId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // The space it belongs to (the owner's decision, 2026-10-25: each space is like a separate site). None: from
  // before spaces had their own, read in «الشركة».
  workspaceId String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("CustomerCreator", fields: [creatorId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]

  @@index([orgId, name])

  @@index([orgId, workspaceId])
}

model Opportunity {
  id          String          @id @default(cuid())
  orgId       String
  number      Int
  customerId  String
  title       String
  value       Float           @default(0)
  stage       OpportunityStage @default(LEAD)
  expectedCloseAt DateTime?
  notes       String?
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // The space it belongs to (the owner's decision, 2026-10-25: each space is like a separate site). None: from
  // before spaces had their own, read in «الشركة».
  workspaceId String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner        User         @relation("OpportunityOwner", fields: [ownerId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, stage])
  @@index([customerId])

  @@index([orgId, workspaceId])
}

enum OpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// A company registration waiting for its owner to confirm the e-mail address (Phase 0 S1, reopened
/// with a check). Nothing in the app exists yet: no User, no Organization, so an unconfirmed request
/// can neither sign in nor hold an address another account needs. The confirmation link carries a
/// random token; only its SHA-256 is stored. Rows expire after 24 h and the hourly purge removes them.
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String
  name         String
  jobTitle     String?
  orgName      String
  passwordHash String
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([email])
  @@index([createdAt])
}

/// A «لوحة» (card) of a space whose layout is CARDS (it works in any space): a note, a prompt, a list, a link, a file or a
/// small hand-typed table. Never hard-deleted: «حذف» sets `archivedAt` and only the OWNER reads the archive.
/// `position` is a fractional rank (one write per move). `data` holds the list items, the table cells or the link url;
/// a FILE card points at a library file (`StoredFile`), it never stores bytes of its own.
model Card {
  id          String    @id @default(cuid())
  orgId       String
  workspaceId String
  createdById String
  kind        String // NOTE | PROMPT | LIST | LINK | FILE | TABLE
  title       String
  body        String?
  data        Json?
  color       String    @default("none") // a theme token name from a small fixed set (src/lib/cards/shared.ts)
  category    String? // «تصنيف»
  tags        String[]
  pinned      Boolean   @default(false)
  position    Float     @default(0)
  fileId      String?
  archivedAt  DateTime?
  // The page inside a card: an approval status set by a moderator (DRAFT | REVIEW | APPROVED | ARCHIVED, src/lib/cards/status.ts),
  // the number of the version the card is at (every saved edit writes a CardRevision and adds one), and the cover picture
  // (a library file of this space, chosen from the gallery).
  status      String    @default("DRAFT")
  version     Int       @default(1)
  coverFileId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  file         StoredFile?  @relation("CardFile", fields: [fileId], references: [id], onDelete: SetNull)
  cover        StoredFile?  @relation("CardCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  revisions    CardRevision[]
  notes        CardNote[]
  ratings      CardRating[]
  attachments  CardAttachment[]

  @@index([workspaceId, archivedAt, pinned, position])
  @@index([orgId, workspaceId])
}

// What a card was BEFORE an edit replaced it: one row per saved edit, never changed or removed (a trigger refuses an UPDATE).
// `version` is the version number the snapshot had; the card itself moves on to version + 1.
model CardRevision {
  id        String   @id @default(cuid())
  cardId    String
  version   Int
  title     String
  body      String?
  data      Json?
  color     String   @default("none")
  category  String?
  tags      String[]
  fileId    String?
  editorId  String // who saved the edit that replaced this snapshot
  createdAt DateTime @default(now())

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  editor User @relation("CardRevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@unique([cardId, version])
  @@index([cardId, createdAt])
}

// A note on a card. PUBLIC: the space's people read it. PRIVATE: only its author reads it (not even the owner).
// A deleted note keeps its row (`deletedAt`).
model CardNote {
  id          String    @id @default(cuid())
  cardId      String
  authorId    String
  body        String
  visibility  String    @default("PUBLIC") // PUBLIC | PRIVATE
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation("CardNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId, visibility, createdAt])
  @@index([authorId, cardId])
}

// A person's stars (1..5) for a card: one per person per card, changeable.
model CardRating {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation("CardRater", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
}

// A picture or file shown in a card's gallery: only the LINK (order and caption); the file itself is a StoredFile.
model CardAttachment {
  id        String   @id @default(cuid())
  cardId    String
  fileId    String
  position  Int      @default(0)
  caption   String?
  addedById String
  createdAt DateTime @default(now())

  card    Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  file    StoredFile @relation("CardAttachmentFile", fields: [fileId], references: [id], onDelete: Cascade)
  addedBy User       @relation("CardAttachmentAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([cardId, fileId])
  @@index([cardId, position])
}

// «مساعد المالك» (the owner, 2026-10-30): an analyst for the OWNER alone, on top of «لوحة المالك». ONE row per company holds the
// settings; the owner's own API key is stored ENCRYPTED (`keyCipher`, src/server/crypto.ts) and is NEVER returned by any route:
// only the last four characters (`keyLast4`), computed when the key was saved, are shown. No foreign keys on purpose (the same
// as the other owner tables): a company's assistant data is not meant to be reachable from any other table.
model AiSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  keyCipher          String?
  keyLast4           String?
  model              String   @default("claude-sonnet-5-5")
  dailyLimit         Int      @default(50)
  monthlyTokenBudget Int      @default(2000000)
  // «اسمح بأسماء الموظفين»: off, the staff are sent as «موظف 1…n» and the answer is shown with real names put back by the server
  allowNames         Boolean  @default(false)
  // «اسمح بعناوين المهام بعد التنقية»: off, no task or space title ever leaves the server
  allowTitles        Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// Counters only (NO content): one row per company, person and company day. `day` is the company's day as YYYY-MM-DD.
model AiUsage {
  id           String @id @default(cuid())
  orgId        String
  userId       String
  day          String
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  requests     Int    @default(0)

  @@unique([orgId, userId, day])
  @@index([orgId, day])
}

// A conversation belongs to ONE owner (`userId`) and is shown to nobody else. `refs` is the table the pseudonyms of THIS
// conversation stand for (U1 → a person id, T3 → a task id ...): a proposal may only name what was in it.
model AiConversation {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  title     String
  refs      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  messages  AiMessage[]
  proposals AiProposal[]

  @@index([orgId, userId, updatedAt])
}

// `content` is the REDACTED text as it was sent, or the model's reply with the pseudonyms (never the real names).
// `sentJson` (on an answer): exactly what was sent to the model for it, for «شو انبعت للنموذج».
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  // USER | ASSISTANT (a text, not an enum: the database refuses anything else with a CHECK)
  role           String
  content        String
  sentJson       Json?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// What the model PROPOSED. Nothing here has been done: only the owner's «وافق» runs it, once, through the ordinary services.
model AiProposal {
  id             String           @id @default(cuid())
  orgId          String
  conversationId String
  messageId      String
  type           String
  paramsJson     Json
  reasonText     String
  // PENDING | APPROVED | REJECTED | EXPIRED | FAILED (a text with a CHECK, like the reward statuses)
  status         String           @default("PENDING")
  createdAt      DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    String?
  resultJson     Json?

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([conversationId, createdAt])
}

// ---------- «حقول مخصصة»: custom fields on the tasks of a project ----------

// One field of a project's schema. `type` is one of src/lib/custom-fields.ts FIELD_TYPES (a string, validated there: a new type is
// code, not a migration). `config` carries what the type needs: { unit } for a number, { currency } for money, { options: [{ id,
// label, color, deleted? }] } for the two choice types. An option that is taken away is MARKED deleted, never removed, so the
// values that point at its id keep making sense (they read «محذوف»). Archiving a field hides it and keeps every value.
model ProjectField {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String
  label       String
  type        String
  required    Boolean  @default(false)
  // fractional position (like the board's tasks): a drag writes ONE row
  position    Decimal  @db.Decimal(22, 10)
  archived    Boolean  @default(false)
  config      Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  TaskFieldValue[]

  @@index([projectId, position])
  @@index([orgId])
}

// The value of one field on one task, in a typed column so numbers sort and sum exactly (Decimal, never a float):
// valueText   short text, long text, link, single choice (the option id), person (the user id)
// valueNumber number, money (integer MINOR units), yes/no (1 or 0)
// valueDate   date (a calendar day)
// valueJson   multiple choice (the array of option ids)
model TaskFieldValue {
  id          String    @id @default(cuid())
  orgId       String
  taskId      String
  fieldId     String
  valueText   String?
  valueNumber Decimal?  @db.Decimal(18, 4)
  valueDate   DateTime? @db.Date
  valueJson   Json?
  updatedById String?
  updatedAt   DateTime  @updatedAt

  task  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field ProjectField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldId])
  @@index([fieldId, valueNumber])
  @@index([fieldId, valueDate])
  @@index([fieldId, valueText])
  @@index([orgId])
}

/// «التسجيل اليومي» (daily check-in): the short stand-up a space's ADMIN turns on. One configuration per space.
/// `questions` is a JSON array of 1 to 5 strings; `weekdays` counts 0 = الأحد to 6 = السبت (the company's week);
/// `timeOfDay` is `HH:MM` in the COMPANY's zone. `participantsMode` is ALL (everybody ACTIVE and not a guest in the space)
/// or LIST (the people of `participantIds`, a JSON array of user ids).
model CheckinConfig {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  questions        Json     @default("[]")
  timeOfDay        String   @default("09:00")
  weekdays         Int[]    @default([0, 1, 2, 3, 4])
  participantsMode String   @default("ALL")
  participantIds   Json     @default("[]")
  active           Boolean  @default(false)
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// One round of a space's check-in on one day of the company's calendar. Made exactly once by the job runner
/// (`INSERT ... ON CONFLICT ("workspaceId", "day") DO NOTHING`), with the questions and the participants as they were that
/// morning (a later change of the configuration does not rewrite a past day). `closedAt` is the instant the round closes
/// (the end of the company's day): answers are accepted and edited until then. `nudgedAt` is set ONCE, by the reminder step.
model CheckinRound {
  id             String    @id @default(cuid())
  workspaceId    String
  day            DateTime  @db.Date
  openedAt       DateTime  @default(now())
  closedAt       DateTime
  questions      Json      @default("[]")
  participantIds Json      @default("[]")
  nudgedAt       DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  answers   CheckinAnswer[]

  @@unique([workspaceId, day])
  @@index([day])
}

/// A person's answer to one round: the texts (aligned with the round's questions), the open tasks they attached (read-only
/// links), or an «إجازة اليوم» (`excused`, no texts). One row per person per round.
model CheckinAnswer {
  id          String    @id @default(cuid())
  roundId     String
  userId      String
  answers     Json      @default("[]")
  taskIds     Json      @default("[]")
  excused     Boolean   @default(false)
  submittedAt DateTime  @default(now())
  editedAt    DateTime?

  round CheckinRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
}

// «طلبات الموافقة ونماذج» (the owner's backlog, 2026-10-31): a person asks for a decision from ONE approver or a chain of up
// to three in order; a form template is a reusable way to ask. An approval ONLY RECORDS a decision: it never moves money
// (`amountMinor` is a note, in integer minor units like a task reward). Nothing here is ever deleted: a cancelled request is a
// status, a resubmitted one is a new `version` with the old steps and attachments kept under their own version number.
// No foreign keys to the company, the space or the person on purpose (the same as the other owner tables): the service
// checks them, and the rows of one request (steps, files) die only with the request.
model ApprovalRequest {
  id          String    @id @default(cuid())
  orgId       String
  workspaceId String
  requesterId String
  title       String
  details     String    @default("")
  // integer minor units (1250 = 12.50) and its currency: both or neither (a CHECK). Never shown to an external partner.
  amountMinor Int?
  currency    String?
  // PENDING | APPROVED | REJECTED | CANCELLED | CHANGES_REQUESTED (a text with a CHECK)
  status      String    @default("PENDING")
  // 1 at the start; a resubmit after «اطلب تعديل» adds one
  version     Int       @default(1)
  // the position (1..3) of the step that decides now, in the current version
  currentStep Int       @default(1)
  // a task, a card or a message this request is about: TASK | CARD | MESSAGE
  linkKind    String?
  linkId      String?
  // the form (the template row of the VERSION it was filled from) and the answers, as validated against that version
  formId      String?
  answers     Json?
  // the earlier versions' content: [{ version, title, details, amountMinor, currency, answers, submittedAt }]
  history     Json      @default("[]")
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  form        FormTemplate?        @relation(fields: [formId], references: [id], onDelete: SetNull)
  steps       ApprovalStep[]
  attachments ApprovalAttachment[]

  @@index([workspaceId, status])
  @@index([requesterId])
  @@index([orgId, createdAt])
}

// One approver of one version of a request. PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | SKIPPED (a later step that was
// never reached: the chain ended, or the request was cancelled). `notifiedAt`: when this approver was told it is their turn.
model ApprovalStep {
  id         String    @id @default(cuid())
  requestId  String
  version    Int
  position   Int
  approverId String
  status     String    @default("PENDING")
  reason     String?
  notifiedAt DateTime?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, version, position])
  @@index([approverId, status])
}

// A file of a request: a chat upload (`StoredFile`, sniffed by the upload route) linked to the version it was attached for.
model ApprovalAttachment {
  id        String   @id @default(cuid())
  requestId String
  fileId    String
  version   Int      @default(1)
  addedById String
  createdAt DateTime @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, fileId, version])
  @@index([requestId])
  @@index([fileId])
}

// «نموذج»: a reusable form of one space. A template edit never changes a row: it adds the next `version` of the same `familyId`
// (the old row stops being `isLatest`), so a request keeps exactly the questions it was filled with.
// `schema` is { fields: [{ id, type, label, required, ... }], approvers: [userId] } (src/lib/approvals/forms.ts checks it).
model FormTemplate {
  id          String    @id @default(cuid())
  orgId       String
  workspaceId String
  familyId    String
  version     Int       @default(1)
  name        String
  description String?
  schema      Json
  isLatest    Boolean   @default(true)
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  requests ApprovalRequest[]

  @@unique([familyId, version])
  @@index([orgId, workspaceId, isLatest])
}

// ---------- «الأداء والتطوير» (team development): the skills checklist ----------

/// Who entered a skill level: a supervisor or the owner (MANUAL), or the person about themselves (SELF). The two are
/// kept side by side and one never replaces the other.
enum SkillSource {
  MANUAL
  SELF
}

/// A skill of the company's checklist («المهارات»). Defined by the owner or whoever holds `people.manage_lines`; never
/// deleted, only archived (the levels already entered keep their meaning).
model Skill {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  category       String    @default("")
  description    String    @default("")
  archivedAt     DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels       PersonSkill[]
  goals        DevGoal[]

  @@index([organizationId, archivedAt])
}

/// One person's level (0-4) in one skill, per source: at most one MANUAL row and one SELF row per person and skill.
model PersonSkill {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  skillId        String
  source         SkillSource
  level          Int
  note           String      @default("")
  updatedById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, source])
  @@index([organizationId, userId])
  @@index([skillId])
}

/// Every change of a level: who, when, from what to what. Append-only: the database refuses an UPDATE (the migration's trigger).
model PersonSkillHistory {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  skillId        String
  source         SkillSource
  /// null: the first entry.
  oldLevel       Int?
  newLevel       Int
  note           String      @default("")
  /// Why, when it is not a plain edit: `goal:<id>` for a development goal confirmed in one click.
  reason         String      @default("")
  changedById    String
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, skillId, createdAt])
  @@index([organizationId, createdAt])
}

// ---------- «الأداء والتطوير» (team development): reviews, development plans, 1:1 notes ----------

/// DRAFT → SUBMITTED → SHARED. Only SHARED reaches the person; a SHARED review is locked (a correction is a new version).
enum ReviewStatus {
  DRAFT
  SUBMITTED
  SHARED
}

/// The reviewer's own status light: تمام / انتبه / يحتاج تدخل. The system only suggests one; this is the one that counts.
enum ReviewLight {
  GREEN
  AMBER
  RED
}

enum DevGoalStatus {
  OPEN
  DONE
  CANCELLED
}

/// What a reviewer rates 1-5: five by default (`code` quality / commitment / collaboration / initiative / communication), which the
/// owner may rename, add to (8 in use at most) and archive. Never deleted: the ratings already given keep their meaning.
model ReviewCriterion {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  position       Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

/// A reviewer's review of one person for one period («2026-10» or «2026-Q4»). One live review per reviewer, person and period; a
/// correction of a SHARED one is the next `version` (the old row is kept). `ratings` is `{ <criterion id>: 1..5 }`. `privateNote`
/// never reaches the person.
model Review {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  reviewerId     String
  period         String
  version        Int          @default(1)
  ratings        Json         @default("{}")
  light          ReviewLight?
  strengths      String       @default("")
  improvement    String       @default("")
  privateNote    String       @default("")
  status         ReviewStatus @default(DRAFT)
  submittedAt    DateTime?
  sharedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewerId, period, version])
  @@index([organizationId, userId, period])
  @@index([organizationId, period, status])
}

/// One goal of a person's development plan: a skill of the catalogue or a free title, a target level, actions, a due day. `proposal`
/// marks a suggestion the person made that a supervisor has not accepted yet. `appliedAt`: its target level was written to the skill.
model DevGoal {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  skillId        String?
  title          String
  targetLevel    Int?
  actions        String        @default("")
  dueDate        DateTime?     @db.Date
  status         DevGoalStatus @default(OPEN)
  proposal       Boolean       @default(false)
  appliedAt      DateTime?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skill        Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status])
}

/// A note of the 1:1 thread about a person, between the owner and the supervisors. The person reads only the ones with `shared`.
/// Never edited or deleted.
model ReviewNote {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  authorId       String
  body           String
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
}

/// A text document of a space («المستندات»): a title and simple text (a small markup of headings, bullets, bold, links and
/// @names, see src/lib/docs/markup.ts: stored as text and drawn by our own renderer, never as HTML). Every saved edit
/// adds one to `version`; the editor sends the version it started from and a document that moved on answers 409.
/// Never hard-deleted: «حذف» sets `archivedAt`. `sharedWithPartners`: an external partner (a guest of the space) reads
/// the document only while this is true. `mentions`: the people the text names (so a later save tells only the new ones).
model Document {
  id                 String    @id @default(cuid())
  orgId              String
  workspaceId        String
  createdById        String
  lastEditorId       String?
  title              String
  content            String    @default("")
  version            Int       @default(1)
  sharedWithPartners Boolean   @default(false)
  mentions           String[]
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lastEditor   User?              @relation("DocumentLastEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  revisions    DocumentRevision[]

  @@index([workspaceId, archivedAt, updatedAt])
  @@index([orgId, workspaceId])
}

/// What a document was BEFORE a save replaced it, one row per saved version worth keeping (a run of quick autosaves by the same
/// person is one row), never changed or removed (a trigger refuses an UPDATE). `version` is the number the snapshot had.
/// `cause`: EDIT, or RESTORE when the save that replaced it was a restore of an older version.
model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  title      String
  content    String
  editorId   String // who wrote the text this snapshot keeps
  cause      String   @default("EDIT")
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User     @relation("DocumentRevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

/// «الأهداف والنتائج»: one measurable key result of an objective (`Goal`), at most five per objective (checked in the service,
/// under a lock on the objective). Progress is `(current - start) / (target - start)`, cut to 0..100 and never stored. The value
/// is `currentValue` (moved by append-only check-ins) UNLESS the key result is linked to a project or to tasks: then it is the
/// number of their finished tasks, counted when read, and check-ins are refused. `unit` is free Arabic text («عميل», «ألف دينار»).
model KeyResult {
  id              String   @id @default(cuid())
  goalId          String
  title           String
  startValue      Float    @default(0)
  targetValue     Float
  currentValue    Float    @default(0)
  unit            String   @default("")
  position        Int      @default(0)
  linkedProjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  goal          Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  linkedProject Project?          @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  tasks         KeyResultTask[]
  updates       KeyResultUpdate[]

  @@index([goalId, position])
  @@index([linkedProjectId])
}

/// The tasks a key result follows (instead of a whole project). A task of another space is refused by the service.
model KeyResultTask {
  keyResultId String
  taskId      String
  createdAt   DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([keyResultId, taskId])
  @@index([taskId])
}

/// One check-in on a key result: the value that day and a short note. APPEND-ONLY (no route edits or deletes a row; the rows
/// only go when their objective is deleted). `authorId` has no foreign key on purpose: a person is never deleted.
model KeyResultUpdate {
  id            String   @id @default(cuid())
  keyResultId   String
  value         Float
  previousValue Float
  note          String   @default("")
  authorId      String
  createdAt     DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([keyResultId, createdAt])
}

/// «الباب» (src/server/services/api-door.ts, docs/contracts/workspace-door.v1.md): a token another Zaki system (System 7) uses to send
/// ideas and tasks to ONE space of ONE company through /api/v1. The token itself is shown once at creation and is never stored:
/// `prefix` finds the row, `tokenHash` (SHA-256 of the whole token) is compared in constant time. It acts in the name of `createdBy`
/// and dies the moment that person is no longer an ACTIVE member holding «integrations.manage», or when it is revoked or expired.
model ApiToken {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String    @unique
  tokenHash      String
  /// Named permissions: ideas.read, ideas.write, tasks.read, tasks.write. None = it can read nothing and write nothing.
  permissions    String[]  @default([])
  /// The one space the token writes to.
  workspaceId    String
  createdById    String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedById    String?
  /// manual | person_suspended | person_offboarded
  revokedReason  String?
  createdAt      DateTime  @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("ApiTokenIssuer", fields: [createdById], references: [id], onDelete: Cascade)
  records      IdempotencyRecord[]
  ideas        Idea[]
  tasks        Task[]

  @@index([organizationId, createdAt])
  @@index([createdById])
}

/// What the door answered for an `Idempotency-Key`, so the same request sent again returns the same answer and creates nothing twice.
/// `key` always starts with the company (`<organizationId>:<tokenId>:<type>:<the sender's key>`): one company's retry can never
/// replace another's. A record is kept for 48 hours.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  tokenId        String
  key            String   @unique
  requestHash    String
  responseStatus Int
  responseBody   Json
  resourceType   String
  resourceId     String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token        ApiToken     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([tokenId, createdAt])
}

// ---------- «القواعد التلقائية» ----------

enum TaskRuleTrigger {
  MOVED_TO_COLUMN
  COMPLETED
  OVERDUE
  CREATED
}

enum TaskRuleRunStatus {
  APPLIED
  PARTIAL
  SKIPPED
  FAILED
}

// A simple if-then rule of a project: ONE trigger and one or two actions (src/lib/task-rules.ts holds their shapes). The space's
// ADMIN and the owner define it; it acts as the system with the rights of the person who last saved it (`runAsId`), re-checked on
// every run. A rule is paused (`active` false), never edited in the log and never really deleted: `deletedAt` hides it and the
// log of what it did stays. `boardId` and the column ids are plain ids on purpose (no foreign key): a board or a column that
// goes makes the rule inert («عمود محذوف»), it never turns a board's rule into a rule of the whole project.
model TaskRule {
  id              String          @id @default(cuid())
  orgId           String
  projectId       String
  // null: every board of the project (only for a rule that names no column)
  boardId         String?
  name            String
  trigger         TaskRuleTrigger
  // MOVED_TO_COLUMN: the column the task has to land in
  triggerColumnId String?
  // 1-2 actions, validated by src/lib/task-rules.ts: [{ type, ... }]
  actions         Json
  active          Boolean         @default(true)
  // OVERDUE looks only at tasks that fell due after this moment (created, or resumed after a pause): never a flood of old tasks
  armedAt         DateTime        @default(now())
  runAsId         String
  createdById     String
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    TaskRuleRun[]

  @@index([projectId, active, trigger])
  @@index([orgId])
}

// The append-only log: one row per (rule, task), written when the rule has acted on the task. The unique pair is the
// once-guard: a rule never acts twice on the same task. Nothing in the app updates or deletes a row. The names are snapshots
// (a renamed rule, a renamed or deleted task do not rewrite history) and `taskId` has no foreign key on purpose.
model TaskRuleRun {
  id        String            @id @default(cuid())
  orgId     String
  projectId String
  ruleId    String
  ruleName  String
  trigger   TaskRuleTrigger
  taskId    String
  taskKey   String
  taskTitle String
  runAsId   String
  status    TaskRuleRunStatus
  // [{ type, status: APPLIED | SKIPPED | FAILED, reason? }] in the order of the rule's actions
  results   Json
  createdAt DateTime          @default(now())

  rule TaskRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, taskId])
  @@index([projectId, createdAt])
  @@index([orgId])
}

// ---------- «مخزون التصنيع»: the stock and cost ledger of a manufacturing space ----------
// (src/server/services/manufacturing*.ts, src/lib/manufacturing/). It records STOCK and COST only: no wallet, no payment, no approval of
// money, and nothing of it is linked to the OMS. Quantities are integers in micro-units of the material base unit (1 unit = 1 000 000),
// money is integer minor units + a currency code, never a float. The balance of a material is the SUM of its movements; nothing stores it.

/// One raw material or packaging item of a manufacturing space (`layout = MANUFACTURING`). `baseUnit` is free Arabic text
/// («علبة», «ستكر», «غرام»): every quantity of the material is counted in it. `currency` is fixed by the first receipt (every
/// lot of a material shares one, so the weighted average is meaningful). Never deleted: `archivedAt`.
model Material {
  id            String    @id @default(cuid())
  orgId         String
  workspaceId   String
  name          String
  code          String?
  baseUnit      String
  lowStockMicro BigInt?
  currency      String?
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("MaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  units        MaterialUnit[]
  lots         MaterialLot[]
  movements    MaterialMovement[]
  counts       MaterialCount[]
  costings     MaterialCosting[]
  priceCorrections MaterialPriceCorrection[]
  recipeLines  RecipeLine[]
  finishedOf   Recipe[]
  orderLines   ProductionOrderLine[]

  @@unique([workspaceId, code])
  @@index([orgId, workspaceId, archivedAt])
}

/// A conversion of one material: 1 `label` = `num` / `den` base units (1 كرتونة = 24 علبة is num 24, den 1).
/// Both are positive integers, so a conversion is exact. Archived instead of deleted.
model MaterialUnit {
  id         String    @id @default(cuid())
  materialId String
  label      String
  num        Int
  den        Int       @default(1)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, label])
}

/// A supplier of a manufacturing space. Not customer data, but the whole feature is closed to partners. Archived instead of deleted.
model Supplier {
  id          String    @id @default(cuid())
  orgId       String
  workspaceId String
  name        String
  note        String?
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lots         MaterialLot[]

  @@index([orgId, workspaceId, archivedAt])
}

/// One stock receipt (دفعة). Written once, never changed (a trigger refuses an UPDATE). `qtyMicro` is in base units (exact);
/// `enteredQtyMicro` / `enteredUnitLabel` / `unitCostMinor` are what was typed (the price of ONE entered unit, in minor units) and
/// `totalCostMinor` is the exact total in minor units, rounded half-up once at write time. Proof: a photo (`proofFileId`: a chat
/// upload read only through the ledger's own door; a plain id and not a foreign key on purpose, so that removing a company cannot trip over
/// a file removed before the lot) or, when there really is none, the reason (`proofNote`): one of them is required.
model MaterialLot {
  id               String    @id @default(cuid())
  orgId            String
  workspaceId      String
  materialId       String
  supplierId       String?
  receivedOn       DateTime  @db.Date
  expiresOn        DateTime? @db.Date
  qtyMicro         BigInt
  enteredQtyMicro  BigInt
  enteredUnitLabel String
  unitCostMinor    BigInt
  totalCostMinor   BigInt
  currency         String
  proofFileId      String?
  proofNote        String?
  note             String?
  /// «استلام بدون سعر»: the price was not known at the receipt. The lot is written with unit cost and total 0 and this flag, and the
  /// price comes once, later, as a MaterialCosting row (the lot itself is never updated). Until then the lot is outside the average.
  costPending      Boolean   @default(false)
  createdById      String
  createdAt        DateTime  @default(now())

  material  Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier  Supplier?          @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  createdBy User               @relation("MaterialLotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  movements MaterialMovement[]
  costing   MaterialCosting?
  corrections MaterialPriceCorrection[]
  producedBy ProductionOrder?       @relation("ProductionOrderOutput")
  orderCostLines ProductionOrderCostLine[]

  @@index([materialId, receivedOn])
  @@index([orgId, workspaceId])
}

/// The append-only ledger. `kind`: RECEIVE (+), ISSUE (-), ADJUST (+/-, a reason), COUNT_ADJUST (+/-, an approved stocktake),
/// REVERSE (the opposite of an earlier movement, `reversesId`; a movement is reversed at most once). `qtyMicro` is signed, in base
/// units; `valueMinor` is the signed value at the weighted average of that moment (a receive: its lot's total). The balance of a
/// material is the SUM of `qtyMicro`, its stock value the SUM of `valueMinor`. A trigger refuses an UPDATE, and a DELETE that is
/// not part of a cascade.
model MaterialMovement {
  id          String   @id @default(cuid())
  orgId       String
  workspaceId String
  materialId  String
  lotId       String?
  kind        String
  qtyMicro    BigInt
  valueMinor  BigInt
  reason      String?
  reversesId  String?  @unique
  countId     String?  @unique
  createdById String
  createdAt   DateTime @default(now())

  material  Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lot       MaterialLot?   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  count     MaterialCount? @relation(fields: [countId], references: [id], onDelete: Cascade)
  createdBy User           @relation("MaterialMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  orderLink ProductionOrderMovement?
  orderCostLine ProductionOrderCostLine?

  @@index([materialId, createdAt])
  @@index([orgId, workspaceId, createdAt])
}

/// A stocktake (جرد) of one material: what was counted, what the book said at that moment, and the difference. PENDING until a
/// SECOND person (never the counter) approves it; only then does a COUNT_ADJUST movement change the balance. REJECTED and MATCHED
/// (no difference) change nothing. The approver differing from the counter is also a database check.
model MaterialCount {
  id               String    @id @default(cuid())
  orgId            String
  workspaceId      String
  materialId       String
  countedById      String
  countedQtyMicro  BigInt
  expectedQtyMicro BigInt
  diffMicro        BigInt
  note             String?
  status           String    @default("PENDING")
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())

  material  Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  countedBy User               @relation("MaterialCounter", fields: [countedById], references: [id], onDelete: Restrict)
  decidedBy User?              @relation("MaterialCountDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  movement  MaterialMovement[]

  @@index([materialId, status])
  @@index([orgId, workspaceId, status, createdAt])
}

// ---------- «مخزون التصنيع», slice 2: the late price, recipes and production orders ----------
// Still stock and cost only: nothing here is linked to the OMS, and no money moves. Every number is an integer (micro-units, minor units).

/// The price of a lot that was received «بدون سعر», written ONCE by a holder of `manufacturing.cost` (unique on `lotId`) and never changed:
/// the lot row itself stays as it was. `unitCostMinor` is the price of ONE of the lot's entered unit (like a priced receipt), `totalCostMinor`
/// the exact total rounded half-up once. A trigger refuses an UPDATE and a plain DELETE, and an insert for a lot that was not received unpriced.
model MaterialCosting {
  id             String   @id @default(cuid())
  orgId          String
  workspaceId    String
  materialId     String
  lotId          String   @unique
  unitCostMinor  BigInt
  totalCostMinor BigInt
  currency       String
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lot          MaterialLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("MaterialCostingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([materialId])
  @@index([orgId, workspaceId])
}

/// A CORRECTION of the price of a lot that was received «بدون سعر» and has been priced (slice 3). `MaterialCosting` stays the FIRST price (unique per
/// lot, released with slice 2); every later price is one of these rows: `seq` counts from 1 per lot, the newest supersedes the one before, and the
/// effective price of a lot is its latest correction, or its costing when it has none. Written once, never changed (a trigger refuses an UPDATE and
/// a plain DELETE); `reason` is mandatory, and the audit log carries no price. The currency never changes. Orders already COMPLETED keep the cost
/// they were frozen with (`ProductionOrderCostLine`): a correction re-prices stock and open orders from then on, never the past.
model MaterialPriceCorrection {
  id             String   @id @default(cuid())
  orgId          String
  workspaceId    String
  materialId     String
  lotId          String
  seq            Int
  unitCostMinor  BigInt
  totalCostMinor BigInt
  currency       String
  reason         String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lot          MaterialLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("MaterialPriceCorrectionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([lotId, seq])
  @@index([materialId])
  @@index([orgId, workspaceId])
}

/// A recipe (وصفة) of a manufacturing space: only its identity and whether it is archived. What it IS lives in its versions, which are
/// written once and never edited (a change is a new version). Archived instead of deleted.
model Recipe {
  id               String    @id @default(cuid())
  orgId            String
  workspaceId      String
  archivedAt       DateTime?
  /// The finished item as a Material of the space (slice 3, «سجّل المنتج النهائي بالمخزون»): when set, completing an order receives its real output into the
  /// stock of this material. Null: the recipe's output is not kept in stock. Its base unit is the recipe's output unit.
  outputMaterialId String?
  createdById      String
  createdAt        DateTime  @default(now())

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("RecipeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  outputMaterial Material?       @relation(fields: [outputMaterialId], references: [id], onDelete: SetNull)
  versions       RecipeVersion[]

  @@index([orgId, workspaceId, archivedAt])
  @@index([outputMaterialId])
}

/// One version of a recipe: the finished item's name and output unit (free Arabic text), and its lines. Written once (a trigger refuses an UPDATE).
/// `version` counts from 1 per recipe.
model RecipeVersion {
  id          String   @id @default(cuid())
  recipeId    String
  version     Int
  name        String
  outputUnit  String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  recipe    Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdBy User              @relation("RecipeVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines     RecipeLine[]
  orders    ProductionOrder[]

  @@unique([recipeId, version])
}

/// A line of a recipe version: how much of a material ONE output unit takes. `qtyMicro` is exact, in the material's BASE unit (what was typed
/// in another unit of the material is kept in `enteredQtyMicro` / `enteredUnitLabel` for the screen).
model RecipeLine {
  id               String @id @default(cuid())
  versionId        String
  materialId       String
  position         Int
  qtyMicro         BigInt
  enteredQtyMicro  BigInt
  enteredUnitLabel String

  version  RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([versionId, materialId])
}

/// A production order (أمر تصنيع): a planned quantity of a recipe version. DRAFT → ISSUED (the materials were taken out of stock, FIFO by
/// lot, as ISSUE movements linked through ProductionOrderMovement) → COMPLETED (the real output is recorded) or RETURNED (the issued
/// materials went back by reversing movements); a DRAFT can be CANCELLED. A trigger allows only these steps and keeps the plan unchanged.
/// The actors of the steps are plain ids (history survives a removed person; nobody is deleted anyway).
model ProductionOrder {
  id              String    @id @default(cuid())
  orgId           String
  workspaceId     String
  seq             Int
  recipeVersionId String
  plannedQtyMicro BigInt
  status          String    @default("DRAFT")
  note            String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  issuedById      String?
  issuedAt        DateTime?
  finishedById    String?
  finishedAt      DateTime?
  actualQtyMicro  BigInt?
  wasteQtyMicro   BigInt?
  wasteNote       String?
  closedById      String?
  closedAt        DateTime?
  closeNote       String?
  /// The lot of finished goods this order put into stock when it was completed (slice 3); null when its recipe keeps no finished stock.
  outputLotId     String?   @unique

  organization  Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipeVersion RecipeVersion           @relation(fields: [recipeVersionId], references: [id], onDelete: NoAction)
  createdBy     User                    @relation("ProductionOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  outputLot     MaterialLot?            @relation("ProductionOrderOutput", fields: [outputLotId], references: [id], onDelete: NoAction)
  lines         ProductionOrderLine[]
  movements     ProductionOrderMovement[]
  costLines     ProductionOrderCostLine[]

  @@unique([workspaceId, seq])
  @@index([orgId, workspaceId, status, createdAt])
}

/// What the order needs of one material: the recipe line's quantity per output unit as it was when the order was made, and the exact
/// requirement (`requiredMicro` = per unit × planned, rounded half-up once). Written once.
model ProductionOrderLine {
  id            String @id @default(cuid())
  orderId       String
  materialId    String
  position      Int
  perUnitMicro  BigInt
  requiredMicro BigInt

  order     ProductionOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material  Material                  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  movements ProductionOrderMovement[]
  costLines ProductionOrderCostLine[]

  @@unique([orderId, materialId])
}

/// The link between an order and the ledger movements it caused (the ISSUE movements of its issue step and the REVERSE movements of its
/// return). A movement belongs to at most one order. Written once.
model ProductionOrderMovement {
  id         String   @id @default(cuid())
  orderId    String
  lineId     String
  movementId String   @unique
  createdAt  DateTime @default(now())

  order    ProductionOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line     ProductionOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  movement MaterialMovement    @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// The cost of a COMPLETED order, frozen (slice 3): one row per issue movement the order made, written once when the order's cost is complete and
/// never changed. `valueMinor` is that movement's share of the order's cost, split by the largest-remainder method so that the shares add up to
/// the order's cost to the minor unit (per currency); `lotTotalMinor` / `lotQtyMicro` are the lot's price and size as they were then, so the screen
/// can show the formula of the past order after the lot was corrected. An order with these rows is never re-priced.
model ProductionOrderCostLine {
  id            String              @id @default(cuid())
  orderId       String
  lineId        String
  movementId    String              @unique
  lotId         String?
  qtyMicro      BigInt
  valueMinor    BigInt
  currency      String
  lotTotalMinor BigInt?
  lotQtyMicro   BigInt?
  position      Int
  createdAt     DateTime            @default(now())

  order    ProductionOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line     ProductionOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  movement MaterialMovement    @relation(fields: [movementId], references: [id], onDelete: Cascade)
  lot      MaterialLot?        @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
