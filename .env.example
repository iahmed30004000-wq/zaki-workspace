# Zakai.io — متغيرات البيئة المطلوبة
# انسخ القيم الفعلية في Coolify (Environment)، ولا تضع أسرارًا حقيقية هنا.

# PostgreSQL (Coolify: استخدم خدمة Postgres الداخلية أو رابط خارجي)
DATABASE_URL="postgresql://user:password@host:5432/database"

# مفتاح توقيع الجلسات — ولّده بـ: openssl rand -hex 32
AUTH_SECRET=""

# اختياري — مفتاح تشفير أسرار التكاملات (تيليجرام / n8n / Google)، مستقل عن AUTH_SECRET (32 حرفًا فأكثر) — ولّده بـ: openssl rand -hex 32
# ENCRYPTION_KEY=

# عمر الجلسة بالساعات (افتراضي 168 = أسبوع)
SESSION_TTL_HOURS=168

# الرابط العام للتطبيق (يُستخدم في OAuth redirect)
APP_URL="https://your-domain.com"

# مستوى السجلات
LOG_LEVEL=info

# اختياري — عدد الـ reverse proxies التي تقف أمام التطبيق (عدد صحيح من 1 إلى 5، الافتراضي 1 = Traefik/Coolify وحده).
# هو الذي يحدّد أي عنوان في X-Forwarded-For يحسبه حدّ محاولات تسجيل الدخول كعنوان الزائر: يعدّ من اليمين
# بهذا العدد، فلا يستطيع الزائر اختيار عنوانه بإرسال الترويسة بنفسه.
# إن كان هناك CDN (مثل Cloudflare) أمام Traefik فاضبطه على 2، وإلا ظهر كل المستخدمين بعنوان واحد
# وتقاسموا حدّاً واحداً. لا تجعله أكبر من العدد الفعلي: يصبح العنوان المحسوب مما كتبه الزائر ويمكنه تخطي الحدّ.
# TRUSTED_PROXY_HOPS=1

# اختياري — تكامل Google Drive (تخزين ملفات المكتبة على Drive المالك، صلاحية drive.file):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# اختياري — المكالمات (صوت وفيديو) على خادم المكالمات تبعنا (LiveKit على Coolify: calls.workspace.zakiai.io).
# العنوان wss://، والمفتاحين بيولّدهن Coolify لخدمة «zaki-calls» (SERVICE_USER_LIVEKIT و SERVICE_PASSWORD_64_LIVEKIT).
# بدونهن التطبيق شغّال، والمكالمات بتقول «خادم المكالمات مش جاهز».
# LIVEKIT_URL=wss://calls.workspace.your-domain.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# اختياري — «كتابة نص الرسالة الصوتية»: خدمة تحويل صوت لنص بتشغّلها إنت على جهازك (faster-whisper-server أو whisper.cpp أو LocalAI،
# بشكل OpenAI: POST /v1/audio/transcriptions). العنوان لازم يكون جهازك أو شبكتك الخاصة (اسم خدمة Docker أو عنوان خاص)، وأي عنوان عام بيترفض.
# بدونها ما بيطلع زر «اكتب النص». والمفتاح «كتابة نص الرسالة الصوتية» بالميزات بيضل مطفي لحد ما تشغّله.
# TRANSCRIBE_URL=http://whisper:8000
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_LANGUAGE=ar

# اختياري — مفتاحين رنّة المكالمات لما يكون الموقع مسكّر (Web Push). بدونهن بيطلعوا لحالهن من ENCRYPTION_KEY
# (أو AUTH_SECRET)، فما في داعي تحطهن إلا إذا بدك مفاتيح ثابتة غيرهن.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# البريد الصادر (SMTP) — لازم لفتح شركة جديدة: التسجيل بيبعت رابط تأكيد، وبدونه بيرد 503.
# SMTP_PORT اختياري: 587 (STARTTLS، الافتراضي) أو 465 (TLS من البداية). MAIL_FROM مثل: Zaki Workspace <no-reply@your-domain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# اختياري — سقف طلبات فتح الشركات على كل السيرفر (فوق حدّ كل عنوان IP). الافتراضي 30 بالساعة و100 باليوم.
# REGISTER_GLOBAL_PER_HOUR=30
# REGISTER_GLOBAL_PER_DAY=100

# اختياري — مجلد الملفات المرفوعة. على Docker/Coolify يُضبط تلقائياً على /app/storage/uploads
# (لازم يكون Persistent Storage). محلياً الافتراضي .data/uploads
# UPLOAD_DIR=

# للاختبارات على قاعدة بيانات حقيقية (npm run test:db): سيرفر Postgres محلي بصلاحية CREATEDB.
# يُنشأ داخله قاعدة مؤقتة لكل تشغيل وتُحذف بعدها. الافتراضي: DATABASE_URL مع اسم القاعدة postgres.
# TEST_DATABASE_ADMIN_URL=postgresql://zaki:zaki_local@localhost:5433/postgres

# اختياري — بوابة المساعد ثابتة من السيرفر بدل ما تنكتب بشاشة الإعدادات (القيمة المضبوطة بتغلب المحفوظة وبتظهر ثابتة).
# العنوان (مع /v1 أو بدونه؛ العنوان الخارجي بدو مفتاح «بوابة نموذج خارجية»)، واسم النموذج، ومفتاح البوابة (ما بينحفظ بقاعدة البيانات).
# ZAKI_GATEWAY_URL=https://glm.erv.zakiai.io/v1
# ZAKI_GATEWAY_MODEL=auto/best-chat
# ZAKI_GATEWAY_API_KEY=
