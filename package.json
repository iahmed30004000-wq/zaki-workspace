{
  "name": "zaki-workspace",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "^8.5.30"
  },
  "scripts": {
    "dev": "node scripts/copy-whiteboard-assets.mjs && node scripts/copy-noise-assets.mjs && next dev",
    "build": "prisma generate && node scripts/copy-whiteboard-assets.mjs && node scripts/copy-noise-assets.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "themes:css": "tsx scripts/build-themes-css.mjs",
    "decor:css": "node scripts/build-decor-css.mjs",
    "icons": "node scripts/make-icons.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx worker/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/busboy": "^1.5.4",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "driver.js": "^1.10.2",
    "emojibase-data": "^18.0.0",
    "frimousse": "^0.4.0",
    "imapflow": "^2.10.0",
    "jose": "^5.9.0",
    "livekit-client": "^2.22.4",
    "lucide-react": "^0.441.0",
    "mailparser": "^3.14.1",
    "next": "^14.2.35",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.30",
    "prisma": "^5.20.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
